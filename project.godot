; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neon Smoke"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://sprites/arcadegamebetter.png"

[autoload]

ResourceManager="*res://scripts/resource_manager.gd"
Global="*res://global.gd"
ArcadeTetracity="*res://scenes/arcade_tetracity.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
TransitionScreen="*res://scenes/transition_screen.tscn"
GlobalCrafting="*res://global_crafting.gd"
GlobalPickup="*res://global pickup sound.tscn"
GlobalPickupManager="*res://scripts/global_pickup_manager.gd"
UI="*res://UI/ui.tscn"

[dialogic]

directories/dch_directory={
"Ada": "res://dialogic/characters/Ada.dch",
"Neeko": "res://dialogic/characters/Neeko.dch",
"Player": "res://dialogic/characters/Player.dch",
"lil fella": "res://dialogic/timelines/lil fella.dch",
"placeholder": "res://placeholder.dch"
}
directories/dtl_directory={
"caught": "res://dialogic/timelines/caught.dtl",
"open_big_door": "res://dialogic/timelines/open_big_door.dtl",
"ouch_glass": "res://dialogic/timelines/ouch_glass.dtl",
"shrimpFriedRice": "res://dialogic/timelines/shrimpFriedRice.dtl",
"shrimpFriedRicePt2": "res://dialogic/timelines/shrimpFriedRicePt2.dtl",
"stamina25": "res://stamina25.dtl",
"stamina50": "res://sounds/stamina50.dtl",
"stamina75": "res://dialogic/timelines/stamina75.dtl",
"starting_fight": "res://dialogic/timelines/starting_fight.dtl",
"trash_dig": "res://dialogic/timelines/trash_dig.dtl",
"wake up little fella": "res://dialogic/timelines/wake up little fella.dtl",
"what the": "res://dialogic/timelines/what the.dtl"
}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style=""
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=false
animations/leave_default_length=0.5
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.0
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={
".?!": 0.1
}
animations/join_default="Fade In Up"
animations/leave_default="Fade Out Down"
text/input_action="dialogue_advance"
text/absolute_autopauses=false
variables={
"playername": ""
}
text/autocolor_names=false
audio/type_sound_bus="SFX"

[dialogue_manager]

general/states=["Global", "ResourceManager"]

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Resources/": "red",
"res://UI/": "gray",
"res://addons/": "green",
"res://dialogic/": "purple",
"res://dialogue/": "purple",
"res://fonts/": "yellow",
"res://scenes/": "teal",
"res://scripts/": "orange",
"res://sounds/": "blue",
"res://sprites/": "pink"
}

[global_group]

glitch_portal_to_internal=""
glitch_portal_to_rl=""
Player=""
drag_iron=""
drag_object=""
drag_object_slot_1=""
drag_object_slot_2=""
drag_battery=""

